@startuml Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle

actor "Utilizador Normal" as User
actor "Administrador" as Admin
actor "Sistema" as System

rectangle "Sistema de Gestão de Reservas de Espaços Desportivos" {

    ' Módulo de Autenticação e Perfil
    usecase "UC01 - Registrar Conta" as UC01
    usecase "UC02 - Efetuar Login" as UC02
    usecase "UC03 - Consultar e Editar Perfil" as UC03

    ' Módulo de Espaços e Equipamentos
    usecase "UC04 - Consultar Espaços" as UC04
    usecase "UC05 - Gerir Espaços Desportivos" as UC05
    usecase "UC06 - Gerir Equipamentos" as UC06

    ' Módulo de Reservas
    usecase "UC07 - Criar Reserva" as UC07
    usecase "UC08 - Consultar Minhas Reservas" as UC08
    usecase "UC09 - Cancelar Reserva" as UC09
    usecase "UC10 - Aprovar / Recusar Reserva" as UC10

    ' Módulo de Relatórios e Automação
    usecase "UC11 - Gerir Utilizadores" as UC11
    usecase "UC12 - Visualizar Relatórios" as UC12
    usecase "UC13 - Expirar Reservas Automatizadas" as UC13
    usecase "UC14 - Concluir Reservas Finalizadas" as UC14

    ' Regras / Sub-rotinas
    usecase "Validar Credenciais" as UC_Auth
    usecase "Verificar Conflito de Horário" as UC_CheckConflict
}

' Relações - Utilizador Normal
User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC07
User --> UC08
User --> UC09

' Relações - Administrador
Admin --> UC02
Admin --> UC03
Admin --> UC04
Admin --> UC05
Admin --> UC06
Admin --> UC09
Admin --> UC10
Admin --> UC11
Admin --> UC12

' Relações - Sistema (Processos Automáticos)
System --> UC13
System --> UC14

' Relacionamentos do tipo Include
UC02 .> UC_Auth : <<include>>
UC07 .> UC_CheckConflict : <<include>>

@enduml